+package com.example.workoutlogger.activities;
+
+import android.content.Intent;
+import android.os.Bundle;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.widget.Button;
+import android.widget.CheckBox;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.appcompat.app.AppCompatActivity;
+
+import com.example.workoutlogger.R;
+import com.example.workoutlogger.database.WorkoutDbHelper;
+import com.example.workoutlogger.models.Exercise;
+import com.example.workoutlogger.models.ExerciseSet;
+import com.example.workoutlogger.models.Workout;
+
+import java.util.List;
+
+public class WorkoutDetailActivity extends AppCompatActivity {
+
+    private static final String EXTRA_WORKOUT_ID = "workout_id";
+
+    private TextView textWorkoutName;
+    private TextView textWorkoutDate;
+    private TextView textWorkoutNotes;
+    private LinearLayout layoutExercisesContainer;
+    private Button buttonSaveProgress;
+
+    private WorkoutDbHelper dbHelper;
+    private int workoutId;
+    private Workout workout;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setContentView(R.layout.activity_workout_detail);
+
+        // Initialize UI components
+        textWorkoutName = findViewById(R.id.text_workout_name);
+        textWorkoutDate = findViewById(R.id.text_workout_date);
+        textWorkoutNotes = findViewById(R.id.text_workout_notes);
+        layoutExercisesContainer = findViewById(R.id.layout_exercises_container);
+        buttonSaveProgress = findViewById(R.id.button_save_progress);
+
+        // Initialize database helper
+        dbHelper = new WorkoutDbHelper(this);
+
+        // Get workout ID from intent
+        workoutId = getIntent().getIntExtra(EXTRA_WORKOUT_ID, -1);
+
+        if (workoutId == -1) {
+            Toast.makeText(this, "Error loading workout", Toast.LENGTH_SHORT).show();
+            finish();
+            return;
+        }
+
+        // Load workout details
+        loadWorkoutDetails();
+
+        // Set up save button
+        buttonSaveProgress.setOnClickListener(v -> saveProgress());
+
+        // Set up action bar
+        if (getSupportActionBar() != null) {
+            getSupportActionBar().setDisplayHomeAsUpEnabled(true);
+            getSupportActionBar().setTitle("Workout Details");
+        }
+    }
+
+    private void loadWorkoutDetails() {
+        // Get workout with all details
+        workout = dbHelper.getWorkoutWithDetails(workoutId);
+
+        if (workout == null) {
+            Toast.makeText(this, "Workout not found", Toast.LENGTH_SHORT).show();
+            finish();
+            return;
+        }
+
+        // Set basic workout info
+        textWorkoutName.setText(workout.getName());
+        textWorkoutDate.setText("Date: " + workout.getDate());
+
+        // Set notes if available
+        String notes = workout.getNotes();
+        if (notes != null && !notes.isEmpty()) {
+            textWorkoutNotes.setText("Notes: " + notes);
+            textWorkoutNotes.setVisibility(View.VISIBLE);
+        } else {
+            textWorkoutNotes.setVisibility(View.GONE);
+        }
+
+        // Get exercises for this workout
+        List<Exercise> exercises = dbHelper.getExercisesForWorkout(workoutId);
+
+        // Clear existing views
+        layoutExercisesContainer.removeAllViews();
+
+        // Add exercise views
+        for (Exercise exercise : exercises) {
+            addExerciseView(exercise);
+        }
+    }
+
+    private void addExerciseView(Exercise exercise) {
+        LayoutInflater inflater = LayoutInflater.from(this);
+        View exerciseView = inflater.inflate(R.layout.item_exercise_detail, null);
+
+        // Get views
+        TextView textExerciseName = exerciseView.findViewById(R.id.text_exercise_name);
+        CheckBox checkExerciseCompleted = exerciseView.findViewById(R.id.check_exercise_completed);
+        LinearLayout layoutSetsContainer = exerciseView.findViewById(R.id.layout_sets_container);
+
+        // Set exercise data
+        textExerciseName.setText(exercise.getName());
+        checkExerciseCompleted.setChecked(exercise.isCompleted());
+
+        // Tag with exercise ID for later retrieval
+        checkExerciseCompleted.setTag(exercise.getId());
+
+        // Get sets for this exercise
+        List<ExerciseSet> sets = dbHelper.getSetsForExercise(exercise.getId());
+
+        // Add set views
+        for (ExerciseSet set : sets) {
+            addSetView(layoutSetsContainer, set);
+        }
+
+        // Add to container
+        layoutExercisesContainer.addView(exerciseView);
+    }
+
+    private void addSetView(LinearLayout container, ExerciseSet set) {
+        LayoutInflater inflater = LayoutInflater.from(this);
+        View setView = inflater.inflate(R.layout.item_set_detail, null);
+
+        // Get views
+        TextView textSetDetails = setView.findViewById(R.id.text_set_details);
+        CheckBox checkSetCompleted = setView.findViewById(R.id.check_set_completed);
+        TextView textSetNotes = setView.findViewById(R.id.text_set_notes);
+
+        // Set details
+        String details = set.getReps() + " reps × " + set.getWeight() + " kg";
+        textSetDetails.setText(details);
+
+        // Set notes if available
+        String notes = set.getNotes();
+        if (notes != null && !notes.isEmpty()) {
+            textSetNotes.setText(notes);
+            textSetNotes.setVisibility(View.VISIBLE);
+        } else {
+            textSetNotes.setVisibility(View.GONE);
+        }
+
+        // Set completion status
+        checkSetCompleted.setChecked(set.isCompleted());
+
+        // Tag with set ID for later retrieval
+        checkSetCompleted.setTag(set.getId());
+
+        // Add to container
+        container.addView(setView);
+    }
+
+    private void saveProgress() {
+        boolean workoutCompleted = true;
+
+        // Process exercises
+        for (int i = 0; i < layoutExercisesContainer.getChildCount(); i++) {
+            View exerciseView = layoutExercisesContainer.getChildAt(i);
+            CheckBox checkExerciseCompleted = exerciseView.findViewById(R.id.check_exercise_completed);
+            LinearLayout layoutSetsContainer = exerciseView.findViewById(R.id.layout_sets_container);
+
+            // Get exercise ID and completion status
+            int exerciseId = (int) checkExerciseCompleted.getTag();
+            boolean exerciseCompleted = checkExerciseCompleted.isChecked();
+
+            // Update exercise completion status
+            dbHelper.updateExerciseCompletion(exerciseId, exerciseCompleted);
+
+            // Process sets
+            boolean allSetsCompleted = true;
+            for (int j = 0; j < layoutSetsContainer.getChildCount(); j++) {
+                View setView = layoutSetsContainer.getChildAt(j);
+                CheckBox checkSetCompleted = setView.findViewById(R.id.check_set_completed);
+
+                // Get set ID and completion status
+                int setId = (int) checkSetCompleted.getTag();
+                boolean setCompleted = checkSetCompleted.isChecked();
+
+                // Update set completion status
+                dbHelper.updateSetCompletion(setId, setCompleted);
+
+                // Check if all sets are completed
+                if (!setCompleted) {
+                    allSetsCompleted = false;
+                }
+            }
+
+            // Auto-check exercise if all sets are completed
+            if (allSetsCompleted && !exerciseCompleted) {
+                checkExerciseCompleted.setChecked(true);
+                dbHelper.updateExerciseCompletion(exerciseId, true);
+            }
+
+            // Check if workout is fully completed
+            if (!exerciseCompleted) {
+                workoutCompleted = false;
+            }
+        }
+
+        // Update workout completion status
+        dbHelper.updateWorkoutCompletion(workoutId, workoutCompleted);
+
+        // Show success message
+        Toast.makeText(this, "Progress saved", Toast.LENGTH_SHORT).show();
+
+        // Return to previous screen
+        setResult(RESULT_OK);
+        finish();
+    }
+
+    @Override
+    public boolean onSupportNavigateUp() {
+        onBackPressed();
+        return true;
+    }
+
+    // Static method to create intent
+    public static Intent newIntent(android.content.Context context, int workoutId) {
+        Intent intent = new Intent(context, WorkoutDetailActivity.class);
+        intent.putExtra(EXTRA_WORKOUT_ID, workoutId);
+        return intent;
+    }
+}
