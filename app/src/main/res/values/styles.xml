<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- Custom styles for components -->
        <item name="materialButtonStyle">@style/CustomButtonStyle</item>
        <item name="cardViewStyle">@style/CustomCardViewStyle</item>
        <item name="toolbarStyle">@style/CustomToolbarStyle</item>

        <!-- Text appearance -->
        <item name="android:textViewStyle">@style/CustomTextViewStyle</item>
        <item name="editTextStyle">@style/CustomEditTextStyle</item>

        <!-- Other customizations -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
    </style>

    <!-- Custom Button Style -->
    <style name="CustomButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Custom CardView Style -->
    <style name="CustomCardViewStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">10dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPadding">12dp</item>
        <item name="cardBackgroundColor">@color/cardBackground</item>
    </style>

    <!-- Custom Toolbar Style -->
    <style name="CustomToolbarStyle" parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextColor">@android:color/white</item>
        <item name="subtitleTextColor">@android:color/white</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- Custom TextView Style -->
    <style name="CustomTextViewStyle" parent="Widget.MaterialComponents.TextView">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Custom EditText Style -->
    <style name="CustomEditTextStyle" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textSecondary</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <!-- No Action Bar Theme -->
    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>